{
  "name": "bijoy-sarkar-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "predev": "npm run db:generate && npm run db:push && npm run db:seed",
    "dev": "next dev --port 4173",
    "build": "next build",
    "start": "next start --port 4173",
    "lint": "eslint .",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:migrate": "node scripts/ensure-db.mjs && prisma migrate dev --config prisma7.config.ts",
    "db:push": "node scripts/ensure-db.mjs && prisma db push --config prisma7.config.ts",
    "db:seed": "prisma db seed --config prisma7.config.ts",
    "db:studio": "prisma studio --config prisma7.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.4.1",
    "lucide-react": "^1.64.0",
    "next": "^16.4.3",
    "next-auth": "^4.24.15",
    "nodemailer": "10.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^7.0.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.3",
    "prisma": "7.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "prisma@7.10.1": true,
    "unrs-resolver@1.12.2": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true
  }
}
